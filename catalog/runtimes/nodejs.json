{
  "schema_version": 1,
  "package": {
    "id": "nodejs",
    "name": "Node.js",
    "summary": "JavaScript runtime; npm is package tooling rather than a separate runtime.",
    "category": "runtimes",
    "homepage": "https://nodejs.org/",
    "documentation": "https://nodejs.org/api/",
    "license": "MIT",
    "vendor": "OpenJS Foundation",
    "tags": [
      "javascript",
      "runtime",
      "node"
    ],
    "install_specs": [
      {
        "support": {
          "os": "windows",
          "architectures": [
            "x86_64"
          ]
        },
        "backend": "winget",
        "native_id": "OpenJS.NodeJS.LTS",
        "source": {
          "id": "winget",
          "name": "WinGet community manifests",
          "kind": "curated",
          "trust": "community_repository",
          "url": "https://github.com/microsoft/winget-pkgs"
        },
        "privilege": "native_prompt",
        "review": {
          "url": "https://github.com/microsoft/winget-pkgs/blob/master/manifests/o/OpenJS/NodeJS/LTS/26.13.0/OpenJS.NodeJS.LTS.installer.yaml",
          "checked_on": "2026-11-11"
        },
        "notes": [
          "WinGet LTS distribution; bundled npm is package tooling."
        ]
      },
      {
        "support": {
          "os": "macos",
          "architectures": [
            "arm64"
          ]
        },
        "backend": "homebrew",
        "native_id": "node",
        "source": {
          "id": "homebrew-core",
          "name": "Homebrew core",
          "kind": "curated",
          "trust": "community_repository",
          "url": "https://github.com/Homebrew/homebrew-core"
        },
        "privilege": "none",
        "review": {
          "url": "https://formulae.brew.sh/api/formula/node.json",
          "checked_on": "2026-11-11"
        },
        "notes": [
          "Homebrew tracks its current Node release, which may differ from the WinGet LTS channel."
        ]
      },
      {
        "support": {
          "os": "linux",
          "architectures": [
            "x86_64"
          ],
          "distributions": [
            "ubuntu"
          ],
          "distribution_versions": [
            "24.04"
          ]
        },
        "backend": "apt",
        "native_id": "nodejs",
        "source": {
          "id": "ubuntu-noble",
          "name": "Ubuntu 24.04 repositories",
          "kind": "curated",
          "trust": "official_repository",
          "url": "https://packages.ubuntu.com/noble/"
        },
        "privilege": "required",
        "review": {
          "url": "https://packages.ubuntu.com/noble/nodejs",
          "checked_on": "2026-11-11"
        },
        "notes": [
          "Ubuntu release-native version may trail upstream supported releases; review lifecycle before selecting this source. npm is a separate Ubuntu package."
        ]
      }
    ],
    "detection": [
      {
        "executable": "node",
        "version_args": [
          "--version"
        ]
      }
    ],
    "environment_guidance": []
  }
}
