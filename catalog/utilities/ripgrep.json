          "url": "https://github.com/microsoft/winget-pkgs"
        },
        "privilege": "native_prompt",
        "review": {
          "url": "https://github.com/microsoft/winget-pkgs/blob/master/manifests/b/BurntSushi/ripgrep/MSVC/15.2.0/BurntSushi.ripgrep.MSVC.installer.yaml",
          "checked_on": "2026-11-11"
        },
