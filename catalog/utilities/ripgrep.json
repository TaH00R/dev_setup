        ]
      },
      {
        "support": {
          "os": "macos",
          "architectures": [
            "arm64"
          ]
        },
        "backend": "homebrew",
        "native_id": "ripgrep",
        "source": {
          "id": "homebrew-core",
          "name": "Homebrew core",
          "kind": "curated",
          "trust": "community_repository",
          "url": "https://github.com/Homebrew/homebrew-core"
        },
        "privilege": "none",
        "review": {
          "url": "https://formulae.brew.sh/api/formula/ripgrep.json",
          "checked_on": "2026-11-11"
        },
        "notes": [
          "The installed executable is rg; this package does not index or scan files automatically."
        ]
