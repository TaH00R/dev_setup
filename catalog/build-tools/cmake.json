{
  "schema_version": 1,
  "package": {
    "id": "cmake",
    "name": "CMake",
    "summary": "Build-system generator; a compiler and a build executor are separate tools.",
    "category": "build-tools",
    "homepage": "https://cmake.org/",
    "documentation": "https://cmake.org/documentation/",
    "license": "BSD-3-Clause",
    "vendor": "Kitware",
    "tags": [
      "cmake",
      "build",
      "generator"
    ],
    "install_specs": [
      {
        "support": {
          "os": "windows",
          "architectures": [
            "x86_64"
          ]
        },
        "backend": "winget",
        "native_id": "Kitware.CMake",
        "source": {
          "id": "winget",
          "name": "WinGet community manifests",
          "kind": "curated",
          "trust": "community_repository",
          "url": "https://github.com/microsoft/winget-pkgs"
        },
        "privilege": "native_prompt",
        "review": {
          "url": "https://github.com/microsoft/winget-pkgs/blob/master/manifests/k/Kitware/CMake/4.4.4/Kitware.CMake.installer.yaml",
          "checked_on": "2026-11-11"
        },
        "notes": [
          "Kitware CMake distribution; review PATH integration options."
        ]
      },
      {
        "support": {
          "os": "macos",
          "architectures": [
            "arm64"
          ]
        },
        "backend": "homebrew",
        "native_id": "cmake",
        "source": {
          "id": "homebrew-core",
          "name": "Homebrew core",
          "kind": "curated",
          "trust": "community_repository",
          "url": "https://github.com/Homebrew/homebrew-core"
        },
        "privilege": "none",
        "review": {
          "url": "https://formulae.brew.sh/api/formula/cmake.json",
          "checked_on": "2026-11-11"
        },
        "notes": [
          "Homebrew command-line CMake formula; a desktop app is a separate cask."
        ]
      },
      {
        "support": {
          "os": "linux",
          "architectures": [
            "x86_64"
          ],
          "distributions": [
            "ubuntu"
          ],
          "distribution_versions": [
            "24.04"
          ]
        },
        "backend": "apt",
        "native_id": "cmake",
        "source": {
          "id": "ubuntu-noble",
          "name": "Ubuntu 24.04 repositories",
          "kind": "curated",
          "trust": "official_repository",
          "url": "https://packages.ubuntu.com/noble/"
        },
        "privilege": "required",
        "review": {
          "url": "https://packages.ubuntu.com/noble/cmake",
          "checked_on": "2026-11-11"
        },
        "notes": [
          "Ubuntu release-native CMake; Ninja, Make and compiler selection are separate."
        ]
      }
    ],
    "detection": [
      {
        "executable": "cmake",
        "version_args": [
          "--version"
        ]
      }
    ],
    "environment_guidance": []
  }
}
